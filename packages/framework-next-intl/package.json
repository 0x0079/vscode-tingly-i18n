{
  "name": "@tingly/framework-next-intl",
  "private": true,
  "version": "0.0.0",
  "description": "Stream N: next-intl adapter.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "echo lint stub",
    "test": "vitest run"
  },
  "dependencies": {
    "@tingly/framework-contract": "workspace:*",
    "@tingly/ast-utils": "workspace:*",
    "@babel/traverse": "^7.25.6",
    "@babel/types": "^7.25.6"
  },
  "devDependencies": {
    "@tingly/test-kit": "workspace:*",
    "@types/babel__traverse": "^7.20.6",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
