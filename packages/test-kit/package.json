{
  "name": "@tingly/test-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Golden-test harness for framework adapters. Each stream consumes runFrameworkTestKit().",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "echo lint stub"
  },
  "dependencies": {
    "@tingly/framework-contract": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
