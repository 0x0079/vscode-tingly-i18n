{
  "name": "@tingly/ast-utils",
  "private": true,
  "version": "0.0.0",
  "description": "Shared AST utilities (BabelTraverser, ScopeBinding, ConstantResolver, TemplateLiteralExpander, JSXAttributeWalker, Vue/Svelte/HTML traversers). Consumed by all framework streams.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "echo lint stub"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
