{
  "name": "@tingly/framework-general",
  "private": true,
  "version": "0.0.0",
  "description": "Regex-only fallback framework. Used by Phase 2 to wire providers without any real framework adapter, and at runtime when no framework is detected.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "echo lint stub",
    "test": "vitest run"
  },
  "dependencies": {
    "@tingly/framework-contract": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
