{
  "name": "vscode-tingly-i18n-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo root for vscode-tingly-i18n",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r --filter=./packages/* lint",
    "clean": "pnpm -r --filter=./packages/* clean && rimraf node_modules",
    "package": "pnpm -F @tingly/extension package",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.10",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
